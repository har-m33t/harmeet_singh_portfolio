# Contact form delivery.
# Without these the form still accepts messages, but tells the visitor plainly
# that nothing will reach an inbox and points them at the direct address.
#
# 1. Create an API key at https://resend.com
# 2. Verify a sending domain, then set CONTACT_FROM_EMAIL to an address on it.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=portfolio@your-verified-domain.com
# Defaults to PROFILE.email from lib/content.ts when unset.
CONTACT_TO_EMAIL=
